// Agent Evidence Recorder — Prisma schema.
// Implements the 7 models in docs/DATA_MODEL.md. Security rules in docs/SECURITY.md:
// - ApiKey stores keyHash only (never plaintext); prefix is a short non-secret label.
// - RedactionFinding stores originalHash only (never the raw sensitive value).
// - Every tenant-scoped table carries organizationId + projectId (resolved from the API key).
//
// Tenant integrity is enforced at the DB level (Codex security review, ADIM 4b):
// - Project is unique on (id, organizationId); a project always belongs to one org.
// - ApiKey/AgentRun reference Project by composite (projectId, organizationId), so a key/run
//   can never point at a project from a different organization.
// - AgentRun is unique on (id, organizationId, projectId); child rows (events, findings,
//   exports) reference the run by that full tenant triple, so a child can never carry a
//   tenant pair that disagrees with its run.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RunStatus {
  running
  completed
  failed
  needs_approval
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum EventType {
  run_started
  user_input
  model_call
  tool_call
  redaction_applied
  human_approval_requested
  human_approval_granted
  // Written only by AER itself (Stage 6), never accepted from the API:
  human_approval_rejected
  human_approval_used
  error
  final_output
  run_completed
}

enum FindingType {
  email
  phone
  api_key
  bearer_token
  credit_card
  national_id
  secret // value under a secret-named field (password, apiKey…); originalHash is "" (not recorded)
}

enum Severity {
  low
  medium
  high
}

/// Verified approval lifecycle. "expired" is not stored: it is pending/approved past expiresAt.
enum ApprovalStatus {
  pending
  approved
  rejected
  revoked
}

enum ExportType {
  json
  pdf
}

enum ExportStatus {
  pending
  ready
  failed
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Owner of this workspace. Nullable so pre-auth orgs (seed/demo/org_default) stay valid.
  // One user owns at most one organization for now (personal workspace; teams deferred).
  ownerUserId String? @unique
  owner       User?   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  projects           Project[]
  apiKeys            ApiKey[]
  runs               AgentRun[]
  idempotencyRecords IdempotencyRecord[]
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys      ApiKey[]
  runs         AgentRun[]

  @@unique([id, organizationId]) // FK target for tenant-consistent (projectId, organizationId)
  @@index([organizationId])
}

/// API key — stores hash only. Plaintext is shown once at creation and never persisted.
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  keyHash        String    @unique
  prefix         String    @db.VarChar(20) // short non-secret prefix; bounded so a full key can't be stored
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, projectId])
}

model AgentRun {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  agentName      String
  status         RunStatus @default(running)
  riskLevel      RiskLevel @default(low)
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  durationMs     Int?
  costMicroUsd   Int       @default(0)
  eventCount     Int       @default(0)
  redactionCount Int       @default(0)
  metadata       Json?
  // Legal hold: a run that is itself under investigation must survive retention pruning, so
  // scripts/prune-runs.ts skips it no matter how old it is. Cleared manually when the hold ends.
  legalHold      Boolean   @default(false)
  // Evidence chain: frozen chain head, written at complete (completed | failed). Null while
  // running and for legacy (pre-chain) runs. See docs/EVIDENCE_INTEGRITY.md.
  seal           String?
  // Self-reported client identity, set once at run creation: sdkName/sdkVersion from the
  // x-aer-sdk header, environment from the request body. Adoption metrics only — a client can
  // claim anything here, so never use these as an authorization or evidence input.
  // Null for runs from clients that don't send them (collector-js <= 0.1.0, raw API calls).
  sdkName        String?
  sdkVersion     String?
  environment    String?
  // Capture policy. redactionPolicy = server-applied masking policy (e.g. "aer-redaction/2"); null
  // for rows written before policies were labelled. captureDeclared = what the CLIENT says it did
  // before sending ({mode, policy, status}); AER cannot verify it. Neither is in the chain hash.
  redactionPolicy String?
  captureDeclared Json?
  // Sourced-assistant lineage (all optional, client-supplied identifiers). parentRunId is NOT a
  // foreign key: the parent may be pruned or never recorded — it is resolved at read time inside
  // the tenant and shown as "missing_context" when absent. Outside the chain hash (Stage 4).
  conversationRef String?
  turnRef         String?
  parentRunId     String?
  // Run manifest (Stage 4), frozen at complete together with the seal: binds run context and each
  // event's out-of-chain fields to the chain head. Null while running and for runs sealed before
  // manifests existed. receipt = the statement (+ optional Ed25519 signature) returned to the
  // client at complete; contains hashes and ids only.
  manifestVersion String?
  manifestHash    String?
  receipt         Json?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project            @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  approvals    Approval[]
  events       AgentEvent[]
  findings     RedactionFinding[]
  exports      AuditExport[]

  @@unique([id, organizationId, projectId]) // FK target for tenant-consistent child rows
  @@index([organizationId, projectId, startedAt])
}

/// Only redacted snapshots are persisted — raw, unredacted payloads are never stored.
model AgentEvent {
  id             String     @id @default(cuid())
  organizationId String
  projectId      String
  runId          String
  seq            Int
  type           EventType
  title          String
  occurredAt     DateTime   @default(now())
  inputRedacted  Json?
  outputRedacted Json?
  riskLevel      RiskLevel?
  costMicroUsd   Int?
  metadata       Json?
  // Evidence chain (append-only). hash = sha256(prevHash + canonical(core)); prevHash links to the
  // previous event (genesis for the first). Nullable for legacy rows. See docs/EVIDENCE_INTEGRITY.md.
  hash           String?
  prevHash       String?
  // Capture policy. redactionPolicy = server-applied masking policy (e.g. "aer-redaction/2"); null
  // for rows written before policies were labelled. captureDeclared = what the CLIENT says it did
  // before sending ({mode, policy, status}); AER cannot verify it. Neither is in the chain hash.
  redactionPolicy String?
  captureDeclared Json?
  // Sourced-assistant evidence (profile "sourced_assistant", see lib/audit/sourced.ts): context
  // used, retrieved vs cited sources, claim links, generation info. Redacted like the other
  // fields. Outside the chain hash until Stage 4 extends coverage.
  sourced         Json?

  run      AgentRun           @relation(fields: [runId, organizationId, projectId], references: [id, organizationId, projectId], onDelete: Cascade)
  findings RedactionFinding[]

  @@unique([runId, seq])
  @@index([organizationId, projectId])
}

/// Redaction finding — stores originalHash only. The raw value is never stored.
model RedactionFinding {
  id             String      @id @default(cuid())
  organizationId String
  projectId      String
  runId          String
  eventId        String?
  findingType    FindingType
  severity       Severity
  fieldPath      String
  originalHash   String
  createdAt      DateTime    @default(now())

  run   AgentRun    @relation(fields: [runId, organizationId, projectId], references: [id, organizationId, projectId], onDelete: Cascade)
  event AgentEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([organizationId, projectId])
}

model AuditExport {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  runId          String
  type           ExportType   @default(json)
  status         ExportStatus @default(pending)
  contentHash    String?
  packet         Json?
  createdAt      DateTime     @default(now())

  run AgentRun @relation(fields: [runId, organizationId, projectId], references: [id, organizationId, projectId], onDelete: Cascade)

  @@index([runId])
  @@index([organizationId, projectId])
}

/// Verified human approval (Stage 6). Requested by the agent (API key) for ONE action on ONE run,
/// decided only by a signed-in user of the same workspace in the dashboard, consumed by the agent
/// with the exact same action and parameters. The agent's key can request and consume, never approve.
/// actionHash / paramsHash = salted sha256 over the RAW action name / canonical params (so two
/// requests that differ only in a redacted value can't share an approval); only redacted copies
/// are stored, never raw values or unsalted hashes.
model Approval {
  id              String         @id @default(cuid())
  organizationId  String
  projectId       String
  runId           String
  action          String         @db.VarChar(300)
  paramsRedacted  Json?
  actionHash      String         @db.VarChar(64)
  paramsHash      String         @db.VarChar(64)
  paramsSalt      String         @db.VarChar(32)
  status          ApprovalStatus @default(pending)
  maxUses         Int            @default(1)
  uses            Int            @default(0)
  requestedAt     DateTime       @default(now())
  expiresAt       DateTime
  decidedAt       DateTime?
  decidedByUserId String?
  lastUsedAt      DateTime?
  /// What the application says happened afterwards (external id/receipt/result). A claim, not verified.
  outcome         Json?

  run AgentRun @relation(fields: [runId, organizationId, projectId], references: [id, organizationId, projectId], onDelete: Cascade)

  @@index([runId])
  @@index([organizationId, projectId, status])
}

/// Idempotency-Key ledger for POST /runs, /events, /complete. Claimed inside the same transaction
/// as the write it guards, so a rolled-back write leaves no claim. Stores only a sha256 of the
/// already-redacted request (never the raw body) and the non-sensitive response (ids, counts).
model IdempotencyRecord {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  key            String   @db.VarChar(200)
  operation      String   @db.VarChar(40) // "run.create" | "event.create" | "run.complete"
  runId          String?
  requestHash    String   @db.VarChar(64)
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, projectId, key]) // tenant-scoped: the same key in two orgs never collides
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth v5 + Prisma adapter). Additive: no existing model changes
// except Organization.ownerUserId (nullable). JWT session strategy is used (required by the
// Credentials provider), so the Session table is kept only for adapter compatibility.
// ---------------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Set only for email/password (Credentials) users; null for Google-only users.
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  organization Organization?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
